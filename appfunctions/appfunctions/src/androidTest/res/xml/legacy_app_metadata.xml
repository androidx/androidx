<!-- Simulates app metadata compiled against an older library version that still used the legacy
     "description" attribute. The library namespace is not resolved by aapt2, so this compiles even
     though the attribute is no longer declared by the library. -->
<AppFunctionAppMetadata xmlns:appfn="http://schemas.android.com/apk/androidx.appfunctions"
    appfn:description="Legacy instructions"
    appfn:displayDescription="Legacy display description" />
