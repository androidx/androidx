<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      remote-creation-compose declares minSdk 29, above this library's minSdk 24, so without this
      override the manifest merger would fail for this library and for any app with minSdk < 29.
      The override is safe because its classes are only loaded on API 37+, where
      RemoteComposeRenderOutput captures documents into RemoteViews(DrawInstructions). The other
      androidx.compose.remote artifacts we depend on declare minSdk 24 and need no override.
      -->
    <uses-sdk tools:overrideLibrary="androidx.compose.remote.creation.compose" />

    <queries>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application>
        <!-- Stores the options requested when pinning a widget, once the launcher has pinned it. -->
        <receiver
            android:name=".RequestPinCallbackReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Backs scrollable ListView widgets on API 24-31. -->
        <service
            android:name=".components.list.AdaptiveListRemoteViewsService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Dispatches ListView item clicks for activity-launching or mixed lists. -->
        <activity
            android:name=".components.list.AdaptiveListClickActivity"
            android:exported="false"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Dispatches ListView item clicks for callback-only lists without starting an activity. -->
        <receiver
            android:name=".components.list.AdaptiveListClickReceiver"
            android:exported="false"
            android:enabled="true" />
    </application>
</manifest>
