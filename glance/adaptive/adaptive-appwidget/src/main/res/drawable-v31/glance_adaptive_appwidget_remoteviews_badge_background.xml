<!--
  Inside of the badge pill, drawn behind the label and inset by the outline's 4dp width, so the
  outline image behind it shows as a ring.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/glance_adaptive_appwidget_remoteviews_widget_background" />
        </shape>
    </item>
</layer-list>
