<!--
  An icon drawn in a filled circle, as the design draws the dashboard header's brand icon. The
  builder caps the glyph and pads the circle out around it to the size the matrix gives the icon.
  The glyph uses android:tint, not app:tint: the host inflates a platform ImageView, not AppCompat.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/glance_adaptive_appwidget_remoteviews_icon_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/glance_adaptive_appwidget_remoteviews_icon_circle">

    <ImageView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:tint="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container"
        tools:ignore="UseAppTint" />
</FrameLayout>
