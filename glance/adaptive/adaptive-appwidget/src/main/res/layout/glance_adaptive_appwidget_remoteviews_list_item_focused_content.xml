<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:id="@+id/glance_adaptive_appwidget_remoteviews_list_item_leading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/glance_adaptive_appwidget_remoteviews_list_item_subtitle"
            style="@style/GlanceAdaptiveAppwidgetRemoteviews.ListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:alpha="0.7"
            android:gravity="start"
            android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Medium"
            android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_primary_container"
            android:visibility="gone" />

        <TextView
            android:id="@+id/glance_adaptive_appwidget_remoteviews_list_item_title"
            style="@style/GlanceAdaptiveAppwidgetRemoteviews.ListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.SemiBold"
            android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_primary_container" />

        <LinearLayout
            android:id="@+id/glance_adaptive_appwidget_remoteviews_list_item_tertiary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_item_tertiary_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:adjustViewBounds="true"
                android:alpha="0.7"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/glance_adaptive_appwidget_remoteviews_on_primary_container"
                android:visibility="gone"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_item_tertiary"
                style="@style/GlanceAdaptiveAppwidgetRemoteviews.ListText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.7"
                android:gravity="start"
                android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Medium"
                android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_primary_container" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/glance_adaptive_appwidget_remoteviews_list_item_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:visibility="gone" />
</merge>
