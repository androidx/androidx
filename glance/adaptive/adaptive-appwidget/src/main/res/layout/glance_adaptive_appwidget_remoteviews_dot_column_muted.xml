<!--
  One below-goal column of a dotted hero graph: a dot and its axis label, for counting discrete items.

  The dot sits at the bottom of the column, above the label, so a row of dots shares one baseline
  however tall the hero slot is. Its color can only be set in XML before API 31, hence one layout
  per color, as for the bars.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_adaptive_appwidget_remoteviews_bar_column"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="bottom|center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/glance_adaptive_appwidget_remoteviews_bar_fill"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/glance_adaptive_appwidget_remoteviews_pill"
        android:backgroundTint="@color/glance_adaptive_appwidget_remoteviews_bar_muted" />

    <TextView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_bar_label"
        style="@style/GlanceAdaptiveAppwidgetRemoteviews.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Medium"
        android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_surface_variant" />
</LinearLayout>
