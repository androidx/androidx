<!--
  Matrix header laid out in a row: leading slot, primary text, the optional secondary text, then
  the optional trailing slot.

  The row is at least 56dp tall and vertically centers its children, while remaining free to grow
  with the font scale rather than clip its text. The 8dp gaps are mirrored by the matrix builder's
  width budget for the primary text. The gap after the leading component is the leading slot's
  padding, so it goes with the slot when there is no leading component.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/glance_adaptive_appwidget_remoteviews_slot_leading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp" />

    <TextView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_primary"
        style="@style/GlanceAdaptiveAppwidgetRemoteviews.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Bold"
        android:textColor="@color/glance_adaptive_appwidget_remoteviews_primary" />

    <TextView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_secondary"
        style="@style/GlanceAdaptiveAppwidgetRemoteviews.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Medium"
        android:textColor="@color/glance_adaptive_appwidget_remoteviews_primary" />

    <!--
      Trailing slot, such as a button. The 8dp gap before it is its padding, so it goes with the
      slot when there is no trailing component.
    -->
    <FrameLayout
        android:id="@+id/glance_adaptive_appwidget_remoteviews_slot_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:visibility="gone" />
</LinearLayout>
