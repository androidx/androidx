<!--
  Bulb cell of an Information Matrix: a single slot component, centered, with no card behind it.

  Kept apart from the main card because its hierarchy is structurally different; folding it into
  the card would leave the card's unused slots hidden in every bulb update. The component is added
  at runtime and centers itself.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/GlanceAdaptiveAppwidgetRemoteviews.Theme" />
