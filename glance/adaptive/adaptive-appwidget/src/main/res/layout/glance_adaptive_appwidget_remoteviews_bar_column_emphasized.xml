<!--
  One goal-met hero chart column: bar and axis label.

  The bar has layout_height="0dp" and layout_weight="1", while the column's weightSum is set at
  runtime to 1 / fraction. With bottom gravity, the bar takes that fraction of the space above the
  label and leaves the remainder as headroom at the top. The bar's color can only be set in XML
  before API 31, hence one layout per color.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_adaptive_appwidget_remoteviews_bar_column"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="bottom|center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/glance_adaptive_appwidget_remoteviews_bar_fill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/glance_adaptive_appwidget_remoteviews_pill"
        android:backgroundTint="@color/glance_adaptive_appwidget_remoteviews_tertiary" />

    <TextView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_bar_label"
        style="@style/GlanceAdaptiveAppwidgetRemoteviews.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Medium"
        android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_surface_variant" />
</LinearLayout>
