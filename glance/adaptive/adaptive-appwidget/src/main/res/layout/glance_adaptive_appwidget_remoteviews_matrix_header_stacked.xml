<!--
  Matrix header stacked vertically, for the narrowest width tier: leading slot, primary text, then
  the optional secondary text.

  A separate layout rather than a runtime orientation change because LinearLayout's orientation is
  only remotable from API 31. The gap after the leading component is the leading slot's padding, so
  it goes with the slot when there is no leading component.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/glance_adaptive_appwidget_remoteviews_slot_leading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_primary"
        style="@style/GlanceAdaptiveAppwidgetRemoteviews.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Bold"
        android:textColor="@color/glance_adaptive_appwidget_remoteviews_primary" />

    <TextView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_secondary"
        style="@style/GlanceAdaptiveAppwidgetRemoteviews.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Medium"
        android:textColor="@color/glance_adaptive_appwidget_remoteviews_primary" />
</LinearLayout>
