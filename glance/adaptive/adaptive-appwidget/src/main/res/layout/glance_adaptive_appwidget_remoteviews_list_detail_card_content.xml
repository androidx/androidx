<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_list_item_title"
        style="@style/GlanceAdaptiveAppwidgetRemoteviews.ListText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.SemiBold"
        android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container" />

    <TextView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_list_detail_card_body"
        style="@style/GlanceAdaptiveAppwidgetRemoteviews.ListText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.8"
        android:gravity="start"
        android:maxLines="2"
        android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container"
        android:visibility="gone" />

    <!-- Static inline check slots avoid nested RemoteViews / duplicate IDs inside ListView. -->
    <LinearLayout
        android:id="@+id/glance_adaptive_appwidget_remoteviews_list_detail_card_checklist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_icon_0"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/glance_adaptive_appwidget_ic_checkbox_unchecked"
                android:tint="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_title_0"
                style="@style/GlanceAdaptiveAppwidgetRemoteviews.ListText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.8"
                android:gravity="start"
                android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_icon_1"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/glance_adaptive_appwidget_ic_checkbox_unchecked"
                android:tint="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_title_1"
                style="@style/GlanceAdaptiveAppwidgetRemoteviews.ListText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.8"
                android:gravity="start"
                android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_icon_2"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/glance_adaptive_appwidget_ic_checkbox_unchecked"
                android:tint="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_title_2"
                style="@style/GlanceAdaptiveAppwidgetRemoteviews.ListText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.8"
                android:gravity="start"
                android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_icon_3"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/glance_adaptive_appwidget_ic_checkbox_unchecked"
                android:tint="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/glance_adaptive_appwidget_remoteviews_list_check_title_3"
                style="@style/GlanceAdaptiveAppwidgetRemoteviews.ListText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.8"
                android:gravity="start"
                android:textColor="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container" />
        </LinearLayout>
    </LinearLayout>
</merge>
