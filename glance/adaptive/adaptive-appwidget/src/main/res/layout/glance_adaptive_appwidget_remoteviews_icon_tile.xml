<!--
  One cell of an icon grid: a filled tile with its glyph, and its label beneath it when the grid
  shows labels, centered on it. The cells of a row share its width equally, and the gap after each
  but the last is set at runtime on the cell, so the tile inside it keeps the gap clear. The builder
  hides the tile of an empty cell, and sets the click and the content description on the tile,
  giving a click only to a tile with an action.

  The glyph uses android:tint, not app:tint: the host inflates a platform ImageView, not AppCompat.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/glance_adaptive_appwidget_remoteviews_icon_tile_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <LinearLayout
        android:id="@+id/glance_adaptive_appwidget_remoteviews_icon_tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glance_adaptive_appwidget_remoteviews_tile_background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/glance_adaptive_appwidget_remoteviews_icon_tile_glyph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/glance_adaptive_appwidget_remoteviews_primary"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/glance_adaptive_appwidget_remoteviews_icon_tile_label"
            style="@style/GlanceAdaptiveAppwidgetRemoteviews.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Medium"
            android:textColor="@color/glance_adaptive_appwidget_remoteviews_primary"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
