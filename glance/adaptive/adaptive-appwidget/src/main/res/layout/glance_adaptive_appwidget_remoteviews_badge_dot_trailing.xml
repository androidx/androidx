<!--
  One trailing status dot of the special badge: a 7x8.8dp pill, colored at runtime with
  setColorFilter, with the 1.4dp gap before it as padding so that it follows the layout direction.
-->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_adaptive_appwidget_remoteviews_badge_dot"
    android:layout_width="8.4dp"
    android:layout_height="8.8dp"
    android:paddingStart="1.4dp"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/glance_adaptive_appwidget_remoteviews_pill" />
