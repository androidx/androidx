<!--
  Contained progress ring: the ring drawn as the whole widget, with the glyph and the value inside it.

  The circle wraps the ring, and is padded out to the container diameter at runtime. Centers itself
  in whichever slot it is added to.

  The glyph uses android:tint, not app:tint: the host inflates a platform ImageView, not AppCompat.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/glance_adaptive_appwidget_remoteviews_contained_circle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/glance_adaptive_appwidget_remoteviews_contained_circle">

    <ImageView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_ring"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- The glyph drawable is set at runtime. -->
        <ImageView
            android:id="@+id/glance_adaptive_appwidget_remoteviews_ring_glyph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/glance_adaptive_appwidget_remoteviews_primary"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/glance_adaptive_appwidget_remoteviews_ring_value"
            style="@style/GlanceAdaptiveAppwidgetRemoteviews.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_horizontal"
            android:textAppearance="@style/GlanceAdaptiveAppwidgetRemoteviews.TextAppearance.Bold"
            android:textColor="@color/glance_adaptive_appwidget_remoteviews_primary" />
    </LinearLayout>
</FrameLayout>
