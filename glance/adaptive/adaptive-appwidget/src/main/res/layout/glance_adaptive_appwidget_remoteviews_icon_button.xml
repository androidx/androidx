<!--
  Icon button slot component: a glyph centered on a filled circle, which the builder pads out to the
  button's diameter at runtime. Centers itself in whichever slot it is added to. The builder sets
  the click and the content description on the circle, and only gives a click to a button with an
  action.

  The glyph uses android:tint, not app:tint: the host inflates a platform ImageView, not AppCompat.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/glance_adaptive_appwidget_remoteviews_icon_button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/glance_adaptive_appwidget_remoteviews_button_circle">

    <ImageView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_icon_button_glyph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:tint="@color/glance_adaptive_appwidget_remoteviews_on_secondary_container"
        tools:ignore="UseAppTint" />
</FrameLayout>
