<!--
  Progress ring slot component, with its glyph centered on it.

  Neither image can be given a size before API 31, so both wrap their drawable and are capped at
  runtime with setMaxWidth / setMaxHeight: adjustViewBounds applies the cap to the measured size, and
  fitCenter scales the drawable into it. Their drawables are at least as large as the cap, so the
  cap is the size. The glyph drawable is set at runtime.

  The glyph uses android:tint, not app:tint: the host inflates a platform ImageView, not AppCompat.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_ring"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/glance_adaptive_appwidget_remoteviews_ring_glyph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:tint="@color/glance_adaptive_appwidget_remoteviews_primary"
        tools:ignore="UseAppTint" />
</FrameLayout>
