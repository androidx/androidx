<!--
  Icon slot component: a glyph tinted with the primary color.

  The image cannot be given a size before API 31, so it wraps its drawable and is capped at runtime
  with setMaxWidth / setMaxHeight, as the progress ring's glyph is. The drawable is set at runtime.

  The glyph uses android:tint, not app:tint: the host inflates a platform ImageView, not AppCompat.
-->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/glance_adaptive_appwidget_remoteviews_icon"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:adjustViewBounds="true"
    android:scaleType="fitCenter"
    android:tint="@color/glance_adaptive_appwidget_remoteviews_primary"
    tools:ignore="UseAppTint" />
