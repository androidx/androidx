<resources>
    <!--
      The integer bitmask representing opting in to all known widget categories that the current
      library version supports. This should be used in the `widgetCategory` XML option to opt in
      having widget available on all known surfaces projected from phone.

      HOME_SCREEN (0x1) + KEYGUARD (0x2) + XR (0x10) = 0x13
    -->
    <integer name="glance_adaptive_widget_category_all_known">0x13</integer>
</resources>
