-if class androidx.credentials.registry.provider.RegistryManager
-keep class androidx.credentials.registry.provider.playservices.RegistryManagerProviderPlayServicesImpl {
  *;
}

# UiDelegationFulfillmentService instantiates this class reflectively (Class.forName on the
# class name supplied by Credential Manager), so nothing references it statically and R8 would
# otherwise strip it from minified apps. Without it, onBind returns a null binder and the
# credential request fails with a timeout.
-if class androidx.credentials.registry.provider.UiDelegationFulfillmentService
-keep class androidx.credentials.registry.provider.playservices.UiDelegationFulfillmentProviderPlayServices {
  *;
}
