<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        style="@style/ScreenLayout"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/GroupLabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fallback Options Authentication" />

        <TextView
            style="@style/LabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Demonstrates single negative button vs multiple fallback options (with icons)." />

        <TextView
            style="@style/GroupLabelText"
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fallback Option:" />

        <Spinner
            android:id="@+id/fallback_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/authenticate_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/authenticate_button_label" />

        <Button
            android:id="@+id/clear_log_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_log_label" />

        <TextView
            style="@style/GroupLabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Log Output:" />

        <TextView
            android:id="@+id/log_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
